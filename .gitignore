.venv/
__pycache__/
*.pyc
.pytest_cache/

# Real inventory and settings may carry internal hostnames and addressing.
config.yaml
inventory/devices.yaml

# Captured configs are sensitive.
baselines/
*.cfg

# Accounts and activity log are per-deployment.
users.yaml
activity.log

# Prometheus scrape token, generated per deployment.
deploy/grafana/scrape-token
deploy/grafana/.env
deploy/grafana/data/

# Firmware images are large binaries — keep them out of git (README is kept).
firmware/**/*.out
firmware/**/*.zip
firmware/**/*.bin

# netlab writes these beside a topology when a lab is brought up. Keep the
# topologies (and labs/README.md) tracked; keep the generated artifacts out.
labs/**/netlab.snapshot.*
labs/**/netlab-devices.yml
labs/**/clab.yml
labs/**/clab-*/
labs/**/.clab/
labs/**/Vagrantfile
labs/**/hosts.yml
labs/**/ansible.cfg
labs/**/host_vars/
labs/**/group_vars/
