{
  "uid": "netauto-compliance",
  "title": "Netauto Compliance",
  "description": "Device reachability and compliance drift, from the netauto audit collector. Values refresh at NETAUTO_METRICS_INTERVAL (15 min by default), not at the dashboard refresh rate.",
  "tags": ["netauto", "network", "compliance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "netauto-prometheus" },
        "query": "label_values(netauto_device_up, device)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Devices monitored",
      "id": 1,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "netauto-prometheus" },
      "targets": [
        { "refId": "A", "expr": "netauto_devices_total", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "noValue": "0" },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Unreachable",
      "id": 2,
      "description": "Devices the last audit could not connect to or authenticate against. Says nothing about whether the device itself is up.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "netauto-prometheus" },
      "targets": [
        { "refId": "A", "expr": "count(netauto_device_up == 0) or vector(0)", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Critical findings",
      "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "netauto-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(netauto_findings_failed{severity=\"critical\"}) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Failing rules",
      "id": 4,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "netauto-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(netauto_rule_failed) or vector(0)", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Last audit",
      "id": 5,
      "description": "Age of the cached snapshot. Should stay under NETAUTO_METRICS_INTERVAL plus one cycle duration.",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "netauto-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - netauto_last_audit_timestamp_seconds",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "never",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1800 },
              { "color": "red", "value": 3600 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Failing rules over time, by severity",
      "id": 6,
      "description": "The compliance drift line. A step up means a rule started failing somewhere in the estate.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "netauto-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity) (netauto_rule_failed{device=~\"$device\"})",
          "legendFormat": "{{severity}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "critical" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "high" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Device reachability",
      "id": 7,
      "description": "1 = the audit connected. Gaps mean the collector was not running.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "netauto-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "netauto_device_up{device=~\"$device\"}",
          "legendFormat": "{{device}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Per-device compliance",
      "id": 8,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "netauto-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "netauto_device_up{device=~\"$device\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "netauto_findings{device=~\"$device\", status=\"pass\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "netauto_findings{device=~\"$device\", status=\"fail\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "netauto_findings_failed{device=~\"$device\", severity=\"critical\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "device", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true,
              "__name__": true, "__name__ 1": true, "__name__ 2": true,
              "__name__ 3": true, "__name__ 4": true,
              "job": true, "job 1": true, "job 2": true, "job 3": true, "job 4": true,
              "instance": true, "instance 1": true, "instance 2": true,
              "instance 3": true, "instance 4": true,
              "status": true, "status 1": true, "status 2": true,
              "status 3": true, "status 4": true,
              "severity": true, "severity 1": true, "severity 2": true,
              "severity 3": true, "severity 4": true
            },
            "renameByName": {
              "device": "Device",
              "platform": "Platform",
              "platform 1": "Platform",
              "Value #A": "Reachable",
              "Value #B": "Passing",
              "Value #C": "Failing",
              "Value #D": "Critical"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Reachable" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "no", "color": "red", "index": 0 },
                      "1": { "text": "yes", "color": "green", "index": 1 }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Critical" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Currently failing rules",
      "id": 9,
      "description": "The actionable list: which rule, on which device. Sourced from netauto_rule_failed == 1.",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "netauto-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "netauto_rule_failed{device=~\"$device\"} == 1",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "__name__": true, "job": true,
              "instance": true, "Value": true
            },
            "renameByName": {
              "device": "Device",
              "rule_id": "Rule",
              "severity": "Severity"
            }
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "field": "Severity" }] }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" }, "noValue": "Nothing failing" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": { "color": "red", "index": 0 },
                      "high": { "color": "orange", "index": 1 },
                      "medium": { "color": "yellow", "index": 2 },
                      "low": { "color": "blue", "index": 3 }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Audit cycle duration",
      "id": 10,
      "description": "How long a full pass over the estate takes. If this approaches NETAUTO_METRICS_INTERVAL, raise the interval or the concurrency.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "netauto-prometheus" },
      "targets": [
        { "refId": "A", "expr": "netauto_audit_cycle_seconds", "legendFormat": "full cycle" },
        {
          "refId": "B",
          "expr": "netauto_device_audit_seconds{device=~\"$device\"}",
          "legendFormat": "{{device}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "full cycle" },
            "properties": [
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }
            ]
          }
        ]
      }
    }
  ]
}
