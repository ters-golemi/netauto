<mxfile host="app.diagrams.net"><diagram name="NetAuto Lab"><mxGraphModel dx="900" dy="650" grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="1100" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="net" value="Internet / ISP" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="160" height="64" as="geometry"/></mxCell><mxCell id="modem" value="Cable modem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#888888;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="120" height="38" as="geometry"/></mxCell><mxCell id="ftd" value="Cisco Firepower 1010  —  ftd-edge-01&#10;FTD 7.0.1 · routed · FDM-managed&#10;&#10;Eth1/1  outside (DHCP WAN)&#10;Eth1/8  802.1Q trunk → switch&#10;Mgmt1/1  OOB 10.10.99.10&#10;&#10;SVIs / gateways:  VLAN10 .1  VLAN20 .1  VLAN30 .1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="180" width="300" height="150" as="geometry"/></mxCell><mxCell id="fsw" value="FortiSwitch 108F  —  fsw-access-01&#10;FortiSwitchOS 7.2.7 · standalone&#10;&#10;port1  trunk → FTD Eth1/8&#10;internal (mgmt)  10.10.10.12  on VLAN10&#10;&#10;port3 NetAuto · port5 user (V10)&#10;port6 server (V20) · port4 AP · 2/7/8 down" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="300" height="150" as="geometry"/></mxCell><mxCell id="hostna" value="NetAuto host&#10;10.10.10.20  (VLAN10)&#10;admin &amp; automation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="1